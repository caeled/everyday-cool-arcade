{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null
    },
    "windows": [],
    "withGlobalTauri": true
  },
  "build": {
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/baton-box/**/*"
    ],
    "targets": "all"
  },
  "identifier": "org.everydaycool.arcade",
  "productName": "Everyday Cool Arcade",
  "version": "1.4.1"
}